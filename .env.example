# Copy these into Vercel's Environment Variables settings — never commit real values to GitHub.

# From your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From console.anthropic.com — kept server-side only, never exposed to the browser
ANTHROPIC_API_KEY=

# A word or short phrase you and your partner will type to open the app
NEXT_PUBLIC_APP_PASSCODE=
